# ══════════════════════════════════════════════════════
# Tripin 환경변수 템플릿
#
# ⚠️ 이 파일에 실제 값을 적지 마세요. 여기는 커밋됩니다.
#    실제 값은 `.env.local` 에만 둡니다 (.gitignore 로 무시됨).
#
#    시작하기:  cp .env.example .env.local
# ══════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────
# 🟢 클라이언트 노출 — NEXT_PUBLIC_ 접두사만 브라우저 번들에 포함됨
# ──────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 공개 게이트 — 확정 핀이 이 수 미만인 조각은 홈·허브·사이트맵에서 빠지고 noindex 된다.
# 미설정 시 1 (빈 조각만 차단). 옛 밀도 실험이 필요하면 8.
# NEXT_PUBLIC_MIN_CONFIRMED_PINS=1


# ── Supabase ───────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사
#
# ℹ️ Tripin은 히든스팟과 키 사용 방식이 다릅니다.
#    히든스팟은 서버 런타임이 없어(앱인토스) 클라이언트가 Supabase를 직접 호출하지만,
#    Tripin은 SEO 때문에 SSG/ISR을 쓰므로 **대부분의 읽기가 빌드 타임(서버)에서** 일어납니다.
#    → anon 키는 필요하되 의존도가 낮고, 실제 주력은 서버 사이드 읽기입니다.

# 🟢 프로젝트 URL — 공개값
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# 🟢 anon 키 — 공개 전제. RLS(Row Level Security)로 보호됩니다.
#    노출되어도 RLS 정책이 막아주므로 브라우저에 나가도 됩니다.
#    ⚠️ 단 RLS를 켜지 않으면 무방비입니다. 테이블 생성 시 반드시 RLS 활성화.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 service_role 키 — RLS를 전부 우회하는 관리자 키.
#    · 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (붙이면 브라우저 번들에 박힙니다)
#    · 어드민 라우트와 로컬 스크립트에서만 사용
#    · 절대 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=

# 🔴 DB 직결 URL — 마이그레이션 실행 전용 (`npm run db:migrate`).
#    대시보드 → Settings → Database → Connection string → "Session pooler" 탭
#    URI 복사 후 [YOUR-PASSWORD] 를 실제 DB 비밀번호로 치환.
#
#    ℹ️ supabase CLI 를 안 쓰는 이유: CLI 는 머신당 한 계정만 로그인된다.
#       이 머신은 히든스팟 계정으로 로그인돼 있고 Tripin 은 별도 계정이다.
#       psql 직결이면 계정 전환 없이 마이그레이션을 돌릴 수 있다.
SUPABASE_DB_URL=


# ── 구글 지도 (렌더링 전용) ─────────────────────────────
# 🟢 브라우저 노출 전제 키 — Maps JS SDK 가 maps.googleapis.com 을 직접 부른다.
#    Cloud Console 에서 반드시 잠글 것:
#      · API 제한: "Maps JavaScript API" **하나만** ← 새어도 비싼 호출 불가
#      · 애플리케이션 제한: HTTP 리퍼러 (localhost:3000/* + 배포 도메인)
#    ℹ️ 렌더러가 구글 지도이므로 Places 데이터 표시가 약관상 허용된다 (LEGAL.md 4장 A안)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# AdvancedMarker 용 Map ID — 미설정 시 개발용 DEMO_MAP_ID 로 떨어진다.
#
# ⚠️ 이건 "권장"이 아니라 **지도 디자인의 유일한 경로**다.
#    AdvancedMarker 가 mapId 를 요구하고, mapId 가 붙으면 구글이 인라인 styles 를
#    무시한다("A Map's styles property cannot be set when a mapId is present").
#    DEMO_MAP_ID 도 mapId 라서 로컬에서조차 인라인 스타일이 안 먹는다.
#    → 이 값이 비어 있는 동안 지도는 구글 기본 스타일 + POI 아이콘으로 나오고,
#      우리 번호 핀이 그 아이콘들에 묻힌다.
#
# 적용 절차 (약 5분, Cloud Console 에서만 가능)
#   1. Google Maps Platform → Map Styles → Create Map Style
#   2. "Import JSON" → src/shared/config/lightbox-map-style.json 내용 붙여넣기
#   3. 저장 → Map Management → Create Map ID (type: JavaScript) → 위 스타일 연결
#   4. 생성된 Map ID 를 여기에 넣기
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# ──────────────────────────────────────────────────────
# 🔴 서버 전용 — NEXT_PUBLIC_ 붙이면 안 되는 것들
# ──────────────────────────────────────────────────────

# ── YouTube Data API ───────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
#
# ⚠️ 쿼터 주의: 기본 10,000 units/day
#    · playlistItems.list / videos.list / channels.list  = 1 unit  ✅ 이걸 쓸 것
#    · search.list                                       = 100 units  ❌ 하루 100회 한계
#    상세: INGEST.md 2장
#
# ⚠️ 영상 메타데이터는 30일 초과 보관 금지 (YouTube API 정책 §III.E.4.d)
#    → 월 1회 갱신 배치 필수. 상세: LEGAL.md 4.5
#    배치 구현: src/app/api/cron/refresh-youtube-meta/route.ts
#    이 키가 없으면 배치가 throw 한다 = 30일 조항을 지킬 수단이 없다는 뜻이다.
YOUTUBE_API_KEY=


# ── 크론 ───────────────────────────────────────────────
# /api/cron/* 를 스케줄러만 부를 수 있게 하는 공유 비밀.
# 라우트가 `Authorization: Bearer $CRON_SECRET` 을 직접 대조한다
# (proxy.ts 의 matcher 는 /admin, /api/admin 만 덮는다).
#
# Vercel 에 배포하면 Cron 이 이 이름의 환경변수를 자동으로 헤더에 실어 보낸다.
# 스케줄은 vercel.json 에 있다 — 매월 1일 03:00 UTC.
#
# Vercel 이 아니면 스케줄러를 직접 붙인다. 둘 다 같은 호출이면 된다:
#   GitHub Actions:  curl -H "Authorization: Bearer $CRON_SECRET" \
#                      https://<도메인>/api/cron/refresh-youtube-meta
#   Supabase pg_cron + pg_net 으로도 같은 요청을 보낼 수 있다.
#
# 값 생성: openssl rand -hex 32
CRON_SECRET=


# ── Google Places (서버 전용) ─────────────────────────
# ℹ️ 비워 둬도 됩니다. 비어 있으면 스크립트가 YOUTUBE_API_KEY 로 폴백합니다 —
#    같은 GCP 프로젝트 키이고 Places API 가 켜져 있으면 그대로 동작합니다
#    (2026-08-10 실측 확인. 별도 키를 새로 만들 필요가 없었습니다).
#
# 용도:
#    · place_id 조회 — 지도앱 딥링크용. 캐싱 제한 면제라 무기한 저장 가능
#    · businessStatus 조회 — 폐업·임시휴업 판별
#      (`scripts/ingest/check-business-status.mjs`. 오래된 영상에서 온 장소는
#       이미 문을 닫았을 수 있어서, 공개 전에 걸러 냅니다)
#
# ⚠️ 예전 주석은 "Places 를 MapLibre 에 표시하면 약관 위반"이라고만 적혀 있었는데,
#    2026-08-04 A안(Google Maps JS API) 채택으로 그 제약은 **현재 스택에 해당 없습니다.**
#    렌더러가 구글이므로 Places 데이터 표시도 허용됩니다. 근거: LEGAL.md 4장 상단.
GOOGLE_PLACES_API_KEY=


# ── LLM (자막 → 장소 후보 분석) ────────────────────────
# 어드민/로컬 스크립트 전용. INGEST.md 2장 ④ 참조.
ANTHROPIC_API_KEY=


# ── 어드민 접근 ────────────────────────────────────────
# /admin 보호용. 생성: openssl rand -base64 32
ADMIN_SECRET=
