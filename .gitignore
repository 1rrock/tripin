# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# ⚠️ 실제 키는 .env.local 에만 둔다. 이 규칙이 그걸 커밋에서 막는다.
.env*
# 템플릿은 커밋한다 — 값 없이 변수 이름과 주석만 있어야 한다.
!.env.example

# IDE / 도구 상태 (히든스팟과 동일 규칙)
.DS_Store
/.idea/
/.omc/
# Claude Code 개인 설정 — 머신별 로컬 (공유 스킬은 .claude/skills 로 커밋)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
